# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
# The wrapper jar must be committed or cloning produces a broken build; the *.jar rule
# above would otherwise exclude it.
!gradle/wrapper/gradle-wrapper.jar

# Gradle and IDE output
.gradle/
build/
.idea/
*.iml
.vscode/

# run-paper test server
run/
